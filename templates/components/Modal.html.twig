{# Modal wrapper with controller #}
<div {{ stimulus_controller('modal', {
         closable: closable,
         backdrop: backdrop
     }) }}
     data-modal-id-value="{{ id }}">

    {# Trigger button (if provided) #}
    {% if block('trigger') is defined %}
        {{ block('trigger') }}
    {% endif %}

    {# Modal backdrop - hidden by default #}
    <div id="{{ id }}"
         class="fixed inset-0 z-50 overflow-y-auto hidden {{ class }}"
         data-modal-target="modal">

    {# Backdrop overlay with blur effect #}
    <div class="fixed inset-0 bg-black/50 backdrop-blur-sm transition-opacity duration-300 opacity-0"
         data-modal-target="backdrop"
         {% if backdrop %}data-action="click->modal#closeModal"{% endif %}>
    </div>

    {# Modal container #}
    <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
        {# Modal panel #}
        <div class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all duration-300 w-full {{ this.getSizeClasses() }} scale-95 opacity-0"
             data-modal-target="panel">

            {# Header #}
            {% if title or closable %}
            <div class="flex items-center justify-between px-6 py-4 border-b">
                {% if title %}
                    <h3 class="text-lg font-semibold text-gray-900" data-modal-target="title">
                        {{ title }}
                    </h3>
                {% endif %}

                {% if closable %}
                    <button type="button"
                            class="text-gray-400 hover:text-gray-600 focus:outline-none focus:text-gray-600 transition-colors"
                            data-action="click->modal#closeModal"
                            aria-label="Close modal">
                        <svg class="h-6 w-6" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                {% endif %}
            </div>
            {% endif %}

            {# Body content #}
            <div class="p-4" data-modal-target="body">
                {{ block('content') }}
            </div>

            {# Footer (if provided) #}
            {% if block('footer') is defined %}
                <div class="px-6 py-4 border-t bg-gray-50" data-modal-target="footer">
                    {{ block('footer') }}
                </div>
            {% endif %}
        </div>
    </div>
    </div>
</div>
