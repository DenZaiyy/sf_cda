<turbo-frame id="profile-change-password">
    <div class="bg-white dark:bg-gray-800 py-8 px-4 shadow sm:rounded-lg sm:px-10">
        
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 p-4 rounded-md {% if type == 'success' %}bg-green-50 text-green-800 border border-green-200{% elseif type == 'danger' %}bg-red-50 text-red-800 border border-red-200{% else %}bg-blue-50 text-blue-800 border border-blue-200{% endif %}"
                     {% if type == 'success' %}data-action="turbo:frame-load->modal#handleSuccess"{% endif %}>
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
        {{ form_start(form, {'attr': {'class': 'space-y-6'}, 'action': path('app.profile.change.password')}) }}

        {% if form.vars.errors|length > 0 %}
            <div class="mb-4 p-4 rounded-md bg-red-50 text-red-800 border border-red-200">
                {{ form_errors(form) }}
            </div>
        {% endif %}

        <div>
            {{ form_label(form.currentPassword) }}
            <div class="mt-1">
                {{ form_widget(form.currentPassword) }}
            </div>
            {% if form.currentPassword.vars.errors|length > 0 %}
                <div class="mt-1 text-sm text-red-600">
                    {{ form_errors(form.currentPassword) }}
                </div>
            {% endif %}
        </div>

        <div class="flex gap-4 w-full">
            <div class="w-full">
                {{ form_label(form.newPassword.first) }}
                <div class="mt-1">
                    {{ form_widget(form.newPassword.first) }}
                </div>
                {% if form.newPassword.first.vars.errors|length > 0 %}
                    <div class="mt-1 text-sm text-red-600">
                        {{ form_errors(form.newPassword.first) }}
                    </div>
                {% endif %}
            </div>
            <div class="w-full">
                {{ form_label(form.newPassword.second) }}
                <div class="mt-1">
                    {{ form_widget(form.newPassword.second) }}
                </div>
                {% if form.newPassword.second.vars.errors|length > 0 %}
                    <div class="mt-1 text-sm text-red-600">
                        {{ form_errors(form.newPassword.second) }}
                    </div>
                {% endif %}
            </div>
        </div>

        <div>
            <button type="submit"
                    class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                Change password
            </button>
        </div>
        {{ form_end(form) }}
    </div>
</turbo-frame>
